{
  "name": "fieldwork",
  "version": "0.1.0",
  "description": "Deterministic generative art: flow fields and reaction-diffusion, rendered to SVG and PNG",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "generative-art",
    "flow-field",
    "reaction-diffusion",
    "marching-squares",
    "simplex-noise",
    "svg",
    "deterministic"
  ],
  "bin": {
    "fieldwork": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "dev": "vite",
    "cli": "npm run build --silent && node dist/cli.js",
    "gallery": "npm run build --silent && node dist/gallery.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
